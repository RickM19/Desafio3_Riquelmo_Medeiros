{
    "compilerOptions": {
        "target": "ES6",
        "lib": ["es6"],

        "module": "commonjs",
        "rootDir": "src",
        "baseUrl": "./",
        "paths": {
            "@config/*": ["src/config/*"],
            "@modules/*": ["src/modules/*"],
            "@shared/*": ["src/shared/*"]
        },
        "resolveJsonModule": true,
        "outDir": "build",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "eslint.config.mjs"]
}
